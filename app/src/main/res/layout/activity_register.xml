<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0C7C1D"
    tools:context=".RegisterActivity">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="315dp"
        android:layout_height="133dp"
        android:gravity="center"
        android:text="CafeTamGo"
        android:textColor="#FFC107"
        android:textSize="48sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.06" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Name"
        android:textColor="#FFC107"
        app:layout_constraintBottom_toTopOf="@+id/etRegisterName"
        app:layout_constraintStart_toStartOf="@+id/etRegisterName" />

    <EditText
        android:id="@+id/etRegisterName"
        android:layout_width="295dp"
        android:layout_height="45dp"
        android:layout_marginTop="140dp"
        android:background="#FFFBFB"
        android:ems="10"
        android:paddingLeft="12dp"
        android:hint="Arthur Morgan"
        android:inputType="textPersonName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Email"
        android:textColor="#FFC107"
        app:layout_constraintBottom_toTopOf="@+id/etRegisterEmail"
        app:layout_constraintStart_toStartOf="@+id/etRegisterEmail" />

    <EditText
        android:id="@+id/etRegisterEmail"
        android:layout_width="295dp"
        android:layout_height="45dp"
        android:layout_marginTop="32dp"
        android:background="#FFFBFB"
        android:ems="10"
        android:paddingLeft="12dp"
        android:hint="example@gmail.com"
        android:inputType="textEmailAddress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etRegisterName" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Password"
        android:textColor="#FFC107"
        app:layout_constraintBottom_toTopOf="@+id/etRegisterPassword"
        app:layout_constraintStart_toStartOf="@+id/etRegisterPassword" />

    <EditText
        android:id="@+id/etRegisterPassword"
        android:layout_width="295dp"
        android:layout_height="47dp"
        android:layout_marginTop="32dp"
        android:background="#FFFBFB"
        android:ems="10"
        android:paddingLeft="12dp"
        android:hint="123456789"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etRegisterEmail" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="295dp"
        android:layout_height="55dp"
        android:layout_marginTop="36dp"
        android:backgroundTint="#FFC107"
        android:gravity="center"
        android:text="REGISTER"
        android:textColor="#0C7C1D"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etRegisterPassword" />

    <Button
        android:id="@+id/btnGoToLogin"
        android:layout_width="295dp"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#FFC107"
        android:gravity="center"
        android:text="LOGIN"
        android:textColor="#0C7C1D"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRegister" />

</androidx.constraintlayout.widget.ConstraintLayout>
